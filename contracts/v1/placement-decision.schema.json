{
  "$id": "https://pohunekd.github.io/means-of-compute/contracts/v1/placement-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlacementDecision",
  "description": "Placement outcome for one work item: chosen host alias or none, with reason and candidate scores.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workItemId", "chosenHostAlias", "reason", "candidates"],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "workItemId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "chosenHostAlias": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "reason": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostAlias", "score", "reason", "excluded"],
        "properties": {
          "hostAlias": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "score": { "type": "number" },
          "reason": { "type": "string", "minLength": 1 },
          "excluded": { "type": "boolean" }
        }
      }
    }
  }
}
