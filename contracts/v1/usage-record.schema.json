{
  "$id": "https://pohunekd.github.io/means-of-compute/contracts/v1/usage-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UsageRecord",
  "description": "Ledger entry for one finished task: tokens per provider and model, session time per host, outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workItemId",
    "tokens",
    "sessionSeconds",
    "retries",
    "humanInterventions",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "workItemId": { "type": "string", "minLength": 1 },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model", "inputTokens", "outputTokens"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "inputTokens": { "type": "integer", "minimum": 0 },
          "outputTokens": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "sessionSeconds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostAlias", "seconds"],
        "properties": {
          "hostAlias": { "type": "string", "minLength": 1 },
          "seconds": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "retries": { "type": "integer", "minimum": 0 },
    "humanInterventions": { "type": "integer", "minimum": 0 },
    "result": { "enum": ["success", "failure", "blocked"] }
  }
}
