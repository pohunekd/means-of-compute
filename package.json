{
  "name": "means-of-compute",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "contracts:check": "bun run scripts/contracts-check.ts",
    "providers:check": "bun run scripts/providers-check.ts",
    "gates": "bun run scripts/gates.ts",
    "budget:check": "bun run src/budget/check.ts",
    "place": "bun run src/placement/cli.ts",
    "plugin:build": "bun run scripts/host-state-build.ts",
    "plugin:digest": "bun run scripts/host-state-digest.ts",
    "fmt": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns=quarantine/**"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0"
  }
}
