{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditorReply",
  "description": "Model reply for one audit: a findings array and nothing else.",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "location", "defect", "scenario", "fixDirection"],
        "properties": {
          "severity": { "enum": ["high", "medium", "low"] },
          "location": { "type": "string", "pattern": "^[^\\^@:]+:[1-9][0-9]*$" },
          "defect": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "scenario": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "fixDirection": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  }
}
