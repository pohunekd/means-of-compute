{
  "$id": "https://pohunekd.github.io/means-of-compute/src/work/store.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkStore",
  "description": "One JSON document holding every WorkItem plus its submission records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "items", "submissions"],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "revision": { "type": "integer", "minimum": 0 },
    "items": { "type": "array", "items": true },
    "submissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["submissionId", "digest", "itemIds", "caller", "submittedAt"],
        "properties": {
          "submissionId": { "type": "string", "pattern": "^sub-[0-9a-f]{16}$" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "itemIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" }
          },
          "caller": { "type": "string", "minLength": 1 },
          "submittedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
