{
  "museCommand": ["muse"],
  "providerId": "meta-api",
  "model": "muse-spark-1.3-contributor",
  "contributorMode": "on",
  "approvalMode": "never",
  "envPassthrough": ["PATH"],
  "mcpConfigPath": "tests/fixtures/coord/d3/mcp.json",
  "budgetGateConfigPath": "config/budget-gate.json",
  "skillDir": ".agents/skills/factory-coord",
  "runsDir": "logs/coord-runs",
  "maxRunsPerDay": 4,
  "maxOutcomeChars": 8000,
  "maxToolOutputBytes": 65536,
  "killGraceMs": 10000,
  "exportTimeoutMs": 60000,
  "plan": {
    "reasoningEffort": "high",
    "maxModelSteps": 40,
    "maxSubmitAttempts": 4,
    "timeoutMs": 1200000
  },
  "react": {
    "reasoningEffort": "medium",
    "maxModelSteps": 20,
    "maxSubmitPerEntry": 2,
    "maxEntries": 3,
    "timeoutMs": 600000
  },
  "watch": {
    "pollMs": 2000,
    "deadlineMs": 120000,
    "maxReactSessions": 2,
    "maxFailedSessions": 2,
    "maxPollErrors": 5,
    "maxFollowupsPerRun": 2,
    "pauseRequestBlockedItems": 3
  },
  "seed": {
    "stateDir": "logs/coord-d3",
    "storeSeedPath": "tests/fixtures/coord/d3/store.json"
  },
  "evidenceDenyPatterns": [
    "/home/",
    "/Users/",
    "192\\.168\\.",
    "\\b10\\.\\d+\\.\\d+\\.\\d+\\b",
    "\\.ts\\.net",
    "\\bsk-[A-Za-z0-9]",
    "nvapi-",
    "moc1\\.",
    "BEGIN [A-Z ]*PRIVATE KEY"
  ]
}
