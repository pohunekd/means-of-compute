#!/bin/sh
# Test-double loginctl for factory-probe tests. Answers from fixture files in
# the directory named by MOC_LOGINCTL_FIXTURE:
#   sessions            : whitespace-separated session ids, one per line
#   session-<id>        : "Key=value" lines for "show-session <id> -p ..."
#   manager             : "Key=value" lines for the manager "show-session"
# Any other invocation fails with exit 1.
set -eu
fixture="${MOC_LOGINCTL_FIXTURE:-}"
if [ -z "$fixture" ]; then
  echo "loginctl double: MOC_LOGINCTL_FIXTURE is not set" >&2
  exit 1
fi
if [ "${1:-}" = "list-sessions" ]; then
  # Fixture lines already look like real "loginctl list-sessions" rows:
  # the session id comes first, followed by dummy columns.
  cat "$fixture/sessions"
  exit 0
fi
if [ "${1:-}" = "show-session" ]; then
  shift
  if [ "${1:-}" = "-p" ]; then
    cat "$fixture/manager"
    exit 0
  fi
  id="$1"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      -p)
        shift
        name="$1"
        grep -E "^${name}=" "$fixture/session-$id" || true
        shift
        ;;
      *) shift ;;
    esac
  done
  exit 0
fi
echo "loginctl double: unsupported invocation: $*" >&2
exit 1
