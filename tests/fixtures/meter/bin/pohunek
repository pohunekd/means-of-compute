#!/bin/sh
# Test-double pohunek for host-token tests. FAKE_POHUNEK_MODE selects the
# answer; FAKE_POHUNEK_ARGS_FILE records the arguments, one per line.
set -eu
if [ -n "${FAKE_POHUNEK_ARGS_FILE:-}" ]; then
  printf '%s\n' "$@" > "$FAKE_POHUNEK_ARGS_FILE"
fi
mode="${FAKE_POHUNEK_MODE:-}"
case "$mode" in
  ok)
    printf '{"ok":{"id":"%s","metadata":{"moc.requestId":"w1-demo:0","moc.meterToken":"%s"}}}' "$3" "$FAKE_POHUNEK_TOKEN"
    ;;
  missing)
    printf '{"ok":{"id":"%s","metadata":{"moc.requestId":"w1-demo:0"}}}' "$3"
    ;;
  malformed)
    printf '{"ok":{"id":"%s","metadata":{"moc.meterToken":"not-a-token"}}}' "$3"
    ;;
  bad-json)
    printf 'not json'
    ;;
  fail)
    echo "pohunek: daemon error: session_not_found" >&2
    exit 1
    ;;
  hang)
    exec sleep 3600
    ;;
  *)
    echo "fake pohunek: unknown FAKE_POHUNEK_MODE" >&2
    exit 1
    ;;
esac
